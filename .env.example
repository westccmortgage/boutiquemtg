# Netlify environment variables for boutiquemtg.com (set in Netlify UI, never commit real values)

# Netlify Forms → GR CRM relay (netlify/functions/submission-created.mjs)
# Create a lead source for "boutiquemtg.com" in GR CRM and paste its 24-hex token here.
BOUTIQUE_CRM_LEAD_TOKEN=
# Optional: defaults to https://grcrm.com/.netlify/functions/lead-inbound
CRM_LEAD_URL=

# Rates proxy (netlify/functions/rates.mjs) — optional override
RATES_SOURCE_URL=https://westcoastcapitalmortgage.com/assets/rates.json
